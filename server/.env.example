# Шаблон конфигурации. Скопируйте в server/.env и заполните на сервере.
# Файл .env в репозиторий не попадает.

NODE_ENV=production
PORT=3000

# Публичный адрес сайта для ссылок в QR-приглашениях
PUBLIC_ORIGIN=https://example.com

# Путь к файлу SQLite (относительно каталога server/)
DATABASE_PATH=./data/jury.db

# Срок действия приглашений судей и устройств: до конца конкурса (Москва, UTC+3)
INVITATION_EXPIRES_AT=2026-10-12T00:00:00+03:00

# Сессия администратора
SESSION_TTL_HOURS=12

# Ограничение попыток входа администратора
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Доверять заголовку X-Forwarded-For только за прокси (nginx на VPS)
TRUST_PROXY=1

# Пароль администратора НЕ указывается здесь.
# Первичная настройка: npm run init-admin (запрашивает пароль интерактивно).
